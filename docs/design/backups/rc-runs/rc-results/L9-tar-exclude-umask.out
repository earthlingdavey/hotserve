## L9b: a bare debian:13 image — what apt brings with backblaze-b2, restic and rclone
$ dpkg -l ca-certificates (before)
un  ca-certificates <none>       <none>       (no description available)
$ apt-get install -s backblaze-b2 | grep -A1 "additional packages" | grep -c ca-certificates   # 1 = brought in
1
$ apt-get install -s restic | grep -A1 "additional packages" | grep -c ca-certificates   # 1 = brought in
0
$ apt-get install -s rclone | grep -A1 "additional packages" | grep -c ca-certificates   # 1 = brought in
0
$ apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances backblaze-b2 | grep -c "^ca-certificates"
1
$ apt-cache depends rclone | grep -i cert
  Suggests: ca-certificates
$ apt-cache depends restic | grep -i cert
(none)
